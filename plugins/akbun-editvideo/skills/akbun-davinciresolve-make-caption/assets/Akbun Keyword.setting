          End = Input { Value = 1, Expression = "min(1,max(0,((time-comp.RenderStart)/max(1,comp.RenderEnd-comp.RenderStart)-CAPTION_TEXT.RevealDelay)/max(0.001,CAPTION_TEXT.RevealDuration)))", },
          StyledText = Input { Value = "오늘의 작은 발견", },
