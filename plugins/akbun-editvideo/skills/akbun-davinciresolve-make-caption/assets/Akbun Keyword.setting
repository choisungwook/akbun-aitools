      Input25 = InstanceInput { SourceOp = "CIRCLE_COLOR", Source = "TopLeftBlue", Name = "CIRCLE Blue", },
      },
      Outputs = { MainOutput1 = InstanceOutput { SourceOp = "CAPTION_LAYOUT", Source = "Output", }, },
      Tools = ordered() {
