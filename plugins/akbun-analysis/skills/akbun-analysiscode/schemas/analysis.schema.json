{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akbun.dev/schemas/analysis.schema.json",
  "title": "akbun-analysiscode component relationship analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "summary",
    "related_project_ids",
    "components",
    "relationships"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"$ref": "#/$defs/project"},
    "summary": {"type": "string", "minLength": 1},
    "related_project_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "root_path",
        "remote",
        "analyzed_commit",
        "analyzed_at",
        "worktree_fingerprint"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "root_path": {"type": "string", "minLength": 1},
        "remote": {"type": ["string", "null"]},
        "analyzed_commit": {"type": "string", "minLength": 1},
        "analyzed_at": {"type": "string", "minLength": 1},
        "worktree_fingerprint": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "description"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "role", "importance", "owned_paths", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["service", "component", "datastore", "message-broker", "external-system"]
        },
        "role": {"type": "string", "minLength": 1},
        "importance": {"enum": ["core", "supporting"]},
        "owned_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "grpc_service": {"type": "string", "minLength": 1},
        "grpc_method": {"type": "string", "minLength": 1},
        "database": {"type": "string", "minLength": 1},
        "table": {"type": "string", "minLength": 1},
        "broker": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "queue": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "kind", "label", "details", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "target_project_id": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": [
            "http",
            "grpc",
            "db-read",
            "db-write",
            "external-api",
            "event-publish",
            "event-subscribe",
            "queue-produce",
            "queue-consume"
          ]
        },
        "label": {"type": "string", "minLength": 1},
        "details": {"$ref": "#/$defs/details"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    }
  }
}
