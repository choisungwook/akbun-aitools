{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akbun.dev/schemas/analysis.schema.json",
  "title": "akbun-analysiscode business flow and component relationship analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "summary",
    "related_project_ids",
    "businesses",
    "apis",
    "components",
    "relationships"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "project": {"$ref": "#/$defs/project"},
    "summary": {"type": "string", "minLength": 1},
    "related_project_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "businesses": {
      "type": "array",
      "items": {"$ref": "#/$defs/business"}
    },
    "apis": {
      "type": "array",
      "items": {"$ref": "#/$defs/api"}
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    },
    "layout": {"$ref": "#/$defs/layout"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "root_path",
        "remote",
        "analyzed_commit",
        "analyzed_at",
        "worktree_fingerprint"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "root_path": {"type": "string", "minLength": 1},
        "remote": {"type": ["string", "null"]},
        "analyzed_commit": {"type": "string", "minLength": 1},
        "analyzed_at": {"type": "string", "minLength": 1},
        "worktree_fingerprint": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "description"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "flows"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "flows": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/flow"}
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "entry", "steps"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "entry": {"$ref": "#/$defs/id"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "protocol", "provider", "entrypoint", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "protocol": {"enum": ["http", "grpc", "graphql", "event", "queue"]},
        "method": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "grpc_service": {"type": "string", "minLength": 1},
        "grpc_method": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "provider": {"$ref": "#/$defs/id"},
        "provider_project_id": {"$ref": "#/$defs/id"},
        "entrypoint": {
          "type": "boolean",
          "description": "true 면 시스템 밖에서 직접 들어오는 진입점이다. 부하분석의 요청량 입력 단위가 된다."
        },
        "flow_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "capacity": {
      "type": "object",
      "description": "배포 매니페스트에서 읽은 컴포넌트 1개(레플리카 1개) 기준 자원. 부하분석의 기본값이다.",
      "additionalProperties": false,
      "required": ["replicas", "cpu_millicores", "memory_mib", "source"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "cpu_millicores": {"type": "integer", "minimum": 1},
        "memory_mib": {"type": "integer", "minimum": 1},
        "max_replicas": {"type": "integer", "minimum": 1},
        "source": {
          "enum": ["manifest", "assumed"],
          "description": "manifest 는 배포 파일에서 확인한 값, assumed 는 근거 없이 채운 기본값이다."
        }
      }
    },
    "load": {
      "type": "object",
      "description": "호출 1건이 이 관계를 통해 하류로 얼마나 증폭되는지.",
      "additionalProperties": false,
      "properties": {
        "fan_out": {
          "type": "number",
          "minimum": 0,
          "description": "부모 요청 1건당 이 관계가 실행되는 횟수. 반복문 안의 호출이면 1보다 크다."
        },
        "fan_out_note": {"type": "string", "minLength": 1},
        "sync": {
          "type": "boolean",
          "description": "true 면 호출자가 응답을 기다린다. 하류 지연이 상류로 그대로 전파된다."
        },
        "crypto": {
          "enum": ["none", "tls", "mtls", "field", "kms"],
          "description": "이 관계를 지날 때 드는 암복호화 비용의 종류."
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": {"enum": ["git", "database", "code"]},
        "label": {"type": "string", "minLength": 1},
        "engine": {
          "enum": [
            "postgres",
            "mysql",
            "rds",
            "aurora",
            "redis",
            "dynamodb",
            "mongodb",
            "elasticsearch",
            "s3",
            "kafka",
            "rabbitmq",
            "sqs",
            "sns",
            "other"
          ]
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "layer",
        "origin",
        "role",
        "importance",
        "owned_paths",
        "evidence"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["service", "module", "component", "datastore", "message-broker", "external-system"]
        },
        "layer": {
          "enum": ["entrypoint", "application", "domain", "infrastructure", "external"]
        },
        "origin": {"$ref": "#/$defs/origin"},
        "capacity": {"$ref": "#/$defs/capacity"},
        "role": {"type": "string", "minLength": 1},
        "importance": {"enum": ["core", "supporting"]},
        "owned_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "grpc_service": {"type": "string", "minLength": 1},
        "grpc_method": {"type": "string", "minLength": 1},
        "database": {"type": "string", "minLength": 1},
        "table": {"type": "string", "minLength": 1},
        "broker": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "queue": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "kind", "label", "details", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "target_project_id": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": [
            "code-call",
            "http",
            "grpc",
            "db-read",
            "db-write",
            "external-api",
            "event-publish",
            "event-subscribe",
            "queue-produce",
            "queue-consume"
          ]
        },
        "label": {"type": "string", "minLength": 1},
        "api": {"$ref": "#/$defs/id"},
        "details": {"$ref": "#/$defs/details"},
        "load": {"$ref": "#/$defs/load"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "layout": {
      "type": "object",
      "description": "View id to component id to saved position. View id is 'service' or 'flow:<flow-id>'.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"}
          }
        }
      }
    }
  }
}
